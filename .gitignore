# Original game installation and derived game data
/TLOTR - War of the Ring/
/extracted/
/converted/

# Original-game research: captures, compendiums, galleries, data dumps and
# third-party reference material stay on the owner's machine
/references/

# Local editor settings and Python caches
/.claude/
.vs/
.idea/
*.user
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Godot/.NET generated caches; imported game content stays local
.godot/
**/bin/
**/obj/
/prototype/Assets/

# Exported game (prototype/export.ps1)
/build/
# Godot editor UID sidecars (the headless export writes one per script)
*.uid

# Smoke/debug captures (prototype/run.ps1 -CapturePath artifacts/...)
/artifacts/

# Smoke reports (prototype/run.ps1, build-217)
/reports/

# Local legacy material, kept out of the repository
/Legacy/
